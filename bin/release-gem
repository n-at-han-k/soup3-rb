#!/usr/bin/env ruby
# frozen_string_literal: true

# Released under the Apache License, Version 2.0.
# Copyright, 2026, by General Intelligence Systems.

# RELEASE-GEM(1)                  General Commands Manual               RELEASE-GEM(1)
#
# NAME
#      bin/release-gem — publish this version
#
# SYNOPSIS
#      bin/release-gem [--dry-run]
#
# DESCRIPTION
#      One gem, one push. This gem is pure Ruby: the binding is
#      GObjectIntrospection::Loader reading a typelib at require time, so there
#      is no extension to compile and no per-platform gem to build.
#
#      That is a change from what this script used to do. Earlier revisions of
#      this gem bound libsoup through the Rust `soup3` crate, so releasing meant
#      publishing a source gem plus a precompiled gem per platform, downloaded
#      from the Cross Compile workflow's artifacts. None of that applies now,
#      and the workflow it read from no longer exists — left as it was, this
#      script aborted with "no successful cross-compile.yml run found".
#
#      The work is `gem kit release`, which gates (a changelog entry for this
#      version, no deprecation deadline come due, a clean working tree), builds,
#      pushes and tags. This script adds the one check gem_kit does not make:
#      that the local version is ahead of what is already on RubyGems. A pushed
#      version cannot be taken back, so it is worth failing before the push
#      rather than after.
#
# ENVIRONMENT
#      Requires a RubyGems API key (~/.gem/credentials) for the push.
#
# EXIT STATUS
#      The bin/release-gem utility exits 0 on success, and >0 if an error occurs.
#
# SEE ALSO
#      bin/test(1), gem(1), "gem kit help", CHANGELOG.md
#
# soup3                           November 3, 2026               RELEASE-GEM(1)

require_relative "../lib/soup3/version"

GEM_NAME = "soup3"
local = Soup3::VERSION
dry_run = ARGV.include?("--dry-run")

puts "Local version: #{local}"

# The one mistake that cannot be taken back: a pushed version is pushed.
remote_output = `gem specification #{GEM_NAME} version --remote 2>&1`

if $?.success?
  remote = remote_output[/version: (.+)/, 1]&.strip
  puts "Remote version: #{remote}"

  if remote && Gem::Version.new(local) <= Gem::Version.new(remote)
    abort "ERROR: local version (#{local}) is not ahead of RubyGems (#{remote})"
  end
else
  puts "Not yet published; this would be the first release."
end

# Build here as well as in `gem kit release`, because a gemspec that cannot
# build should fail before anything is pushed, and because the built gem is
# what you would carry to another machine to release by hand.
puts "\nBuilding #{GEM_NAME}-#{local}.gem..."
abort "ERROR: gem build failed" unless system("gem", "build", "#{GEM_NAME}.gemspec")

if dry_run
  puts "\n--dry-run: built but not pushed. Gates that `gem kit release` would apply:"
  system("gem", "kit", "release", "--dry-run")
  exit 0
end

puts "\nReleasing via gem kit..."
abort "ERROR: gem kit release failed" unless system("gem", "kit", "release")

puts "\nReleased #{GEM_NAME} #{local}"
